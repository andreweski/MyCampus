// MyCampus ERD — render with: dot -Tpng docs/erd.dot -o docs/erd.png
digraph ERD {
  graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.6, ranksep=1.2, fontname="Helvetica"];
  node  [shape=plain, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=10, color="#5f6880", arrowhead=crow, arrowtail=tee, dir=both];

  users [label=<
  <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9fa8da">
   <tr><td bgcolor="#283593" colspan="2"><font color="white"><b>users</b></font></td></tr>
   <tr><td align="left"><b>PK</b></td><td port="pk" align="left">user_id INTEGER</td></tr>
   <tr><td align="left">UQ</td><td align="left">email TEXT (NOCASE)</td></tr>
   <tr><td></td><td align="left">password_hash TEXT</td></tr>
   <tr><td></td><td align="left">first_name, last_name TEXT</td></tr>
   <tr><td></td><td align="left">major, bio TEXT</td></tr>
   <tr><td></td><td align="left">role TEXT (student|admin)</td></tr>
   <tr><td></td><td align="left">created_at TEXT</td></tr>
  </table>>];

  sessions [label=<
  <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9fa8da">
   <tr><td bgcolor="#283593" colspan="2"><font color="white"><b>sessions</b></font></td></tr>
   <tr><td align="left"><b>PK</b></td><td align="left">token TEXT</td></tr>
   <tr><td port="fk" align="left">FK</td><td align="left">user_id → users</td></tr>
   <tr><td></td><td align="left">created_at, expires_at</td></tr>
  </table>>];

  categories [label=<
  <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9fa8da">
   <tr><td bgcolor="#283593" colspan="2"><font color="white"><b>categories</b></font></td></tr>
   <tr><td align="left"><b>PK</b></td><td port="pk" align="left">category_id INTEGER</td></tr>
   <tr><td align="left">UQ</td><td align="left">name TEXT</td></tr>
   <tr><td></td><td align="left">description TEXT</td></tr>
  </table>>];

  meetups [label=<
  <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9fa8da">
   <tr><td bgcolor="#f57c00" colspan="2"><font color="white"><b>meetups</b></font></td></tr>
   <tr><td align="left"><b>PK</b></td><td port="pk" align="left">meetup_id INTEGER</td></tr>
   <tr><td port="host" align="left">FK</td><td align="left">host_id → users</td></tr>
   <tr><td port="cat" align="left">FK</td><td align="left">category_id → categories</td></tr>
   <tr><td></td><td align="left">title, description TEXT</td></tr>
   <tr><td></td><td align="left">location TEXT</td></tr>
   <tr><td></td><td align="left">start_time, end_time TEXT</td></tr>
   <tr><td></td><td align="left">capacity INTEGER (2–500)</td></tr>
   <tr><td></td><td align="left">created_at, updated_at</td></tr>
  </table>>];

  rsvps [label=<
  <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9fa8da">
   <tr><td bgcolor="#2e7d32" colspan="2"><font color="white"><b>rsvps</b> (junction)</font></td></tr>
   <tr><td port="u" align="left"><b>PK</b>,FK</td><td align="left">user_id → users</td></tr>
   <tr><td port="m" align="left"><b>PK</b>,FK</td><td align="left">meetup_id → meetups</td></tr>
   <tr><td></td><td align="left">joined_at TEXT</td></tr>
  </table>>];

  comments [label=<
  <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9fa8da">
   <tr><td bgcolor="#283593" colspan="2"><font color="white"><b>comments</b></font></td></tr>
   <tr><td align="left"><b>PK</b></td><td align="left">comment_id INTEGER</td></tr>
   <tr><td port="m" align="left">FK</td><td align="left">meetup_id → meetups</td></tr>
   <tr><td port="u" align="left">FK</td><td align="left">user_id → users</td></tr>
   <tr><td></td><td align="left">body TEXT (1–1000)</td></tr>
   <tr><td></td><td align="left">created_at TEXT</td></tr>
  </table>>];

  user_interests [label=<
  <table border="0" cellborder="1" cellspacing="0" cellpadding="5" color="#9fa8da">
   <tr><td bgcolor="#2e7d32" colspan="2"><font color="white"><b>user_interests</b> (junction)</font></td></tr>
   <tr><td port="u" align="left"><b>PK</b>,FK</td><td align="left">user_id → users</td></tr>
   <tr><td port="c" align="left"><b>PK</b>,FK</td><td align="left">category_id → categories</td></tr>
  </table>>];

  users:pk:e -> sessions:fk:w        [label="1 : N  has"];
  users:pk:e -> meetups:host:w       [label="1 : N  hosts"];
  categories:pk:e -> meetups:cat:w   [label="1 : N  classifies"];
  users:pk:e -> rsvps:u:w            [label="1 : N"];
  meetups:pk:e -> rsvps:m:w          [label="1 : N  attended via"];
  meetups:pk:e -> comments:m:w       [label="1 : N  has"];
  users:pk:e -> comments:u:w         [label="1 : N  writes"];
  users:pk:e -> user_interests:u:w   [label="1 : N"];
  categories:pk:e -> user_interests:c:w [label="1 : N"];
}
